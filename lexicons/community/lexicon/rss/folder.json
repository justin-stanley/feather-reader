{
  "lexicon": 1,
  "id": "community.lexicon.rss.folder",
  "defs": {
    "main": {
      "type": "record",
      "description": "A named grouping of subscriptions. A writer that rewrites a folder record must keep fields it does not know.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "description": "Sort hint among sibling folders. Unset sorts after every set value."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the folder was made."
          }
        }
      }
    }
  }
}
